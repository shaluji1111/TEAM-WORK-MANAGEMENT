# Local development uses a SQLite file through the same libSQL client.
# For Vercel, use a remote Turso libsql:// URL and its database-scoped token.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
BETTER_AUTH_URL=http://localhost:3000
# Generate each secret separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
CRON_SECRET=
